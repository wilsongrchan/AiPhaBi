{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash site/tools/vercel-build.sh",
  "outputDirectory": "site",
  "installCommand": "echo '沒有 npm 依賴，跳過'",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/principles.html",
      "destination": "/yuanze.html",
      "permanent": true
    },
    {
      "source": "/conventional.html",
      "destination": "/yueding.html",
      "permanent": true
    },
    {
      "source": "/try.html",
      "destination": "/shida.html",
      "permanent": true
    },
    {
      "source": "/dingping.html",
      "destination": "/shangping.html",
      "permanent": true
    }
  ]
}
